# --- Required ---
BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
# On Railway this is optional: RAILWAY_PUBLIC_DOMAIN is used automatically if APP_URL is empty.
APP_URL=https://YOUR-HTTPS-DOMAIN.example

# --- Recommended ---
MAIN_CHANNEL_ID=
ADMIN_IDS=
BACKUP_CHANNEL_URL=https://t.me/Atrangii_re_new
# Railway: mount a volume at /app/data and keep this value
DATABASE_PATH=/app/data/bot.db

# --- Optional ---
# true = the Mini App API only answers requests coming from inside Telegram
REQUIRE_TG_AUTH=false
# false = never send "new post" notifications
NOTIFY_ENABLED=true
# seconds to wait so an album / burst of posts becomes ONE notification
NOTIFY_DELAY=8
# posts loaded per page in the Mini App (5-50)
POSTS_PAGE_SIZE=20
